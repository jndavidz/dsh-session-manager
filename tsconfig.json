{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "@deepseek-ai/dsh-client-ui-slots": [
        "./types/stubs.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar/client": [
        "./types/stubs.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "./types/stubs.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
